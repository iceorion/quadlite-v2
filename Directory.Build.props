<Project>
  <!--
    共享构建属性：net48 / C# 5 语法子集 / 零 NuGet 依赖。
    FrameworkPathOverride 由构建命令参数化，不绑定单机工具链路径。
    B0 只建骨架，src 下尚无产品源码；源码与 QuadLite.Tests 的 runner 自 B1 起加入。
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>5</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <FrameworkPathOverride Condition="'$(FrameworkPathOverride)' == ''">$(MSBuildProgramFiles32)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.8</FrameworkPathOverride>
  </PropertyGroup>
</Project>
